{
  "name": "wazelo-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Wazelo CRM: contacts, conversations, deals and WhatsApp messaging from any MCP client",
  "type": "module",
  "bin": {
    "wazelo-mcp": "dist/index.js"
  },
  "files": [
