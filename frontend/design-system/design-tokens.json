        "$description": "Glass layers. Level 1 = cards, level 2 = dialogs/drawers/rail, floating = menus/tooltips.",
        "level-1": {
          "$type": "string",
          "$value": "fill rgb(18 20 29 / 0.72); border rgb(255 255 255 / 0.09); inset 0 1px 0 rgb(255 255 255 / 0.07); shadow 0 12px 36px -8px rgb(0 0 0 / 0.55)"
        },
        "level-2": {
          "$type": "string",
          "$value": "fill rgb(26 29 42 / 0.9); blur 20px saturate 190%; border rgb(255 255 255 / 0.14); amber glow 0 0 24px -2px rgb(245 158 11 / 0.08)"
        },
        "floating": {
          "$type": "string",
          "$value": "fill rgb(26 29 42 / 0.94); blur 20px saturate 180%"
        },
        "canvas": {
          "$type": "string",
          "$value": "#0b0c10 + amber radial glows (0.2 / 0.17 / 0.07 alpha), background-attachment fixed"
        }
