# Copy to .env.local for development. NEXT_PUBLIC_* values are baked in at BUILD time,
# so set them before `next build` for production.
#
# Development: leave as below (backend on :8080).
# Production: either
#   a) same-domain API (recommended — refresh cookie stays first-party):
#        NEXT_PUBLIC_API_URL=/api/v1
#        BACKEND_URL=https://api.your-domain.com     (Next proxies /api/v1 to it)
#        NEXT_PUBLIC_WS_URL=https://api.your-domain.com/ws   (Next can't proxy WebSockets)
#   b) separate API domain:
#        NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
#        NEXT_PUBLIC_WS_URL=https://api.your-domain.com/ws
# A production build never falls back to localhost; unset values use this site's origin.

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
# BACKEND_URL=

# Marketing site (links on auth pages)
# NEXT_PUBLIC_SITE_URL=https://wazelo.in

# Razorpay public key (test key in dev, live key in production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
